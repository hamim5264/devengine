rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* =========================
       HELPERS
    ========================== */
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email == "hamim.leon@gmail.com";
    }

    function isStaff() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/staff_members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/staff_members/$(request.auth.uid)).data.status == "active";
    }

    function isAdminOrStaff() {
      return isAdmin() || isStaff();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /* =========================
       STAFF MEMBERS
    ========================== */
    match /staff_members/{staffId} {
      // Admin has full CRUD access
      allow read, write: if isAdmin();

      // Staff can read their own record (staffId == auth uid)
      allow read: if isSignedIn() && request.auth.uid == staffId;
    }

    /* =========================
       STAFF ROLES
    ========================== */
    match /staff_roles/{roleId} {
      // Admin has full CRUD access
      allow read, write: if isAdmin();

      // Signed in users can read roles
      allow read: if isSignedIn();
    }

    /* =========================
       STAFF ATTENDANCE
    ========================== */
    match /staff_attendance/{attendanceId} {
      allow read, write: if isAdmin();
      allow read: if isSignedIn() && (resource == null || resource.data.staffUid == request.auth.uid || resource.data.staffId == request.auth.uid);
      allow create, update: if isSignedIn() && (request.resource.data.staffUid == request.auth.uid || request.resource.data.staffId == request.auth.uid);
    }

    /* =========================
       STAFF ATTENDANCE REQUESTS (MISSED DATES)
    ========================== */
    match /staff_attendance_requests/{requestId} {
      allow read, write: if isAdmin();
      allow read: if isSignedIn() && (resource == null || resource.data.staffUid == request.auth.uid || resource.data.staffId == request.auth.uid);
      allow create: if isSignedIn() && (request.resource.data.staffUid == request.auth.uid || request.resource.data.staffId == request.auth.uid);
    }

    /* =========================
       STAFF DAILY WORK UPDATES
    ========================== */
    match /staff_work_updates/{updateId} {
      allow read, write: if isAdmin();
      allow read: if isSignedIn() && (resource == null || resource.data.staffUid == request.auth.uid || resource.data.staffId == request.auth.uid);
      allow create, update: if isSignedIn() && (request.resource.data.staffUid == request.auth.uid || request.resource.data.staffId == request.auth.uid);
    }

    /* =========================
       STAFF LEAVE APPLICATIONS
    ========================== */
    match /staff_leave_requests/{leaveId} {
      allow read, write: if isAdmin();
      allow read: if isSignedIn() && (resource == null || resource.data.staffUid == request.auth.uid || resource.data.staffId == request.auth.uid);
      allow create: if isSignedIn() && (request.resource.data.staffUid == request.auth.uid || request.resource.data.staffId == request.auth.uid);
    }

    /* =========================
       STAFF OFF-DAY SWAP REQUESTS
    ========================== */
    match /staff_offday_swap_requests/{swapId} {
      allow read, write: if isAdmin();
      allow read: if isSignedIn() && (resource == null || resource.data.staffUid == request.auth.uid || resource.data.staffId == request.auth.uid);
      allow create: if isSignedIn() && (request.resource.data.staffUid == request.auth.uid || request.resource.data.staffId == request.auth.uid);
    }

    /* =========================
       EMPLOYEE TASKS & DEADLINES
    ========================== */
    match /employee_tasks/{taskId} {
      allow read, write: if isAdmin();
      allow read: if isSignedIn() && (resource == null || resource.data.assignedToStaffUid == request.auth.uid || resource.data.assignedToStaffId == request.auth.uid || resource.data.assignedToEmail == request.auth.token.email);
      allow update: if isSignedIn() && (resource != null && (resource.data.assignedToStaffUid == request.auth.uid || resource.data.assignedToStaffId == request.auth.uid || resource.data.assignedToEmail == request.auth.token.email));
    }

    /* =========================
       SYSTEM UPDATE LOGS
    ========================== */
    match /update_logs/{logId} {
      // Public can read system updates and changelogs
      allow read: if true;
      allow create, update, delete: if isAdminOrStaff();
    }

    /* =========================
       NETWORK HUBS
    ========================== */
    match /network_hubs/{hubId} {
      // Public can read network routing nodes and status
      allow read: if true;
      allow create, update, delete: if isAdminOrStaff();
    }

    /* =========================
       LANDING SECTIONS CMS
    ========================== */
    match /landing_sections/{sectionId} {
      // Public can read landing page configurations
      allow read: if true;
      allow create, update, delete: if isAdminOrStaff();
    }

    /* =========================
       TERMS & CONDITIONS CMS
    ========================== */
    match /terms_config/{docId} {
      // Public can read terms and conditions
      allow read: if true;
      allow create, update, delete: if isAdminOrStaff();
    }

    /* =========================
       PRIVACY POLICY CMS
    ========================== */
    match /privacy_config/{docId} {
      // Public can read privacy policy
      allow read: if true;
      allow create, update, delete: if isAdminOrStaff();
    }

    /* =========================
       SECURITY PROTOCOL CMS
    ========================== */
    match /security_config/{docId} {
      // Public can read security protocol
      allow read: if true;
      allow create, update, delete: if isAdminOrStaff();
    }

    /* =========================
       DOCUMENTATION & API CMS
    ========================== */
    match /documentation_config/{docId} {
      // Public can read documentation & API access
      allow read: if true;
      allow create, update, delete: if isAdminOrStaff();
    }

    /* =========================
       COMMERCIAL LICENSE CMS
    ========================== */
    match /license_config/{docId} {
      // Public can read commercial license agreement
      allow read: if true;
      allow create, update, delete: if isAdminOrStaff();
    }

    /* =========================
       PROJECT AGREEMENTS & CONTRACTS
    ========================== */
    match /agreements/{agreementId} {
      // Admin has full CRUD access; staff/contributors can read their own contract
      allow read: if isAdmin() || (isSignedIn() && (
        resource == null ||
        resource.data.contributor.contributorEmail == request.auth.token.email ||
        resource.data.staffId == request.auth.uid ||
        resource.data.staffUid == request.auth.uid
      ));
      allow write: if isAdmin();
    }

    /* =========================
       STRICT NO-RETURN & REFUND POLICY CMS
    ========================== */
    match /refund_config/{docId} {
      // Public can read refund policy
      allow read: if true;
      allow create, update, delete: if isAdminOrStaff();
    }

    /* =========================
       ARCHIVE & PROJECTS CMS
    ========================== */
    match /archive_config/{docId} {
      // Public can read archive configuration
      allow read: if true;
      allow create, update, delete: if isAdminOrStaff();
    }

    /* =========================
       LAUNCHPAD & APP LAB CMS
    ========================== */
    match /launchpad_config/{docId} {
      // Public can read launchpad configuration
      allow read: if true;
      allow create, update, delete: if isAdminOrStaff();
    }

    /* =========================
       SERVICES & INQUIRIES
    ========================== */
    match /services/{serviceId} {
      // Public can read services catalog
      allow read: if true;
      allow create, update, delete: if isAdminOrStaff();
    }

    match /service_inquiries/{inquiryId} {
      // Public can submit project inquiries
      allow create: if true;
      allow read, update, delete: if isAdminOrStaff();
    }

    /* =========================
       LAB PROJECTS (Upcoming / Ongoing)
    ========================== */
    match /lab_projects/{projectId} {
      // Public can read lab projects (visibility filtered client-side)
      allow read: if true;
      allow create, update, delete: if isAdminOrStaff();
    }

    /* =========================
       LAB & GLOBAL CATEGORIES
    ========================== */
    match /lab_categories/{catId} {
      allow read: if true;
      allow write: if isAdminOrStaff();
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdminOrStaff();
    }

    /* =========================
       PROJECTS
    ========================== */
    match /projects/{projectId} {
      // Public can read projects (isPublic filter handled in queries/client)
      allow read: if true;
      allow create, update, delete: if isAdminOrStaff();
    }

    /* =========================
       APP LAB
    ========================== */
    match /appLab/{appId} {
      // Public can read apps
      allow read: if true;
      allow create, update, delete: if isAdminOrStaff();
    }

    /* =========================
       TAGS
    ========================== */
    match /tags/{tagId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrStaff();
    }

    /* =========================
       CURRENCIES
    ========================== */
    match /currencies/{currencyId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrStaff();
    }

    /* =========================
       USERS
    ========================== */
    match /users/{userId} {
      // User can read/write own profile; admin can read all users
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update, delete: if isOwner(userId);
    }

    /* =========================
       REVIEWS & TRUST WALL
    ========================== */
    match /reviews/{reviewId} {
      // Public can read all reviews
      allow read: if true;

      // Anyone (client or guest) can submit a review with pending status
      allow create: if true;

      // Admin can approve, reject, or delete any review; users can edit/delete their own
      allow update, delete: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    /* =========================
       PURCHASES
    ========================== */
    match /purchases/{purchaseId} {
      // Allow users to record their purchases
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;

      // Users can view/manage their own; Admin can view all purchases
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);

      allow update, delete: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    /* =========================
       ORDERS & MANUAL PAYMENTS
    ========================== */
    match /orders/{orderId} {
      // Anyone can submit an order without logging in
      allow create: if true;

      // Public can read orders (for confirmation & order tracking by ID)
      allow read: if true;

      // Admin or authorized staff can update status or delete
      allow update, delete: if isAdminOrStaff();
    }

    /* =========================
       BLOGS & CHRONICLES
    ========================== */
    match /blogs/{blogId} {
      // Public can read all published or individual blogs
      allow read: if true;
      allow write: if isAdminOrStaff();
    }

    /* =========================
       TEAM & ABOUT STUDIO
    ========================== */
    match /team_members/{memberId} {
      allow read: if true;
      allow write: if isAdminOrStaff();
    }

    match /studio_about/{docId} {
      allow read: if true;
      allow write: if isAdminOrStaff();
    }

    /* =========================
       CAREER & JOB CIRCULARS
    ========================== */
    match /job_circulars/{circularId} {
      // Public can read all active circulars
      allow read: if true;
      allow write: if isAdminOrStaff();
    }

    /* =========================
       CANDIDATE APPLICATIONS
    ========================== */
    match /job_applications/{applicationId} {
      // Anyone can submit a job application without logging in
      allow create: if true;
      allow read, update, delete: if isAdminOrStaff();
    }

    /* =========================
       FOOTER SOCIAL LINKS
    ========================== */
    match /footer_socials/{linkId} {
      allow read: if true;
      allow write: if isAdminOrStaff();
    }

    /* =========================
       SYSTEM SETTINGS & MAINTENANCE
    ========================== */
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isAdminOrStaff();
    }

    /* =========================
       SITE ANALYTICS & VISITOR TRACKING
    ========================== */
    match /site_analytics/{docId} {
      allow read: if true;
      allow write: if true;
    }

    /* =========================
       SYSTEM ACTIVITY LOGS
    ========================== */
    match /activity_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdminOrStaff();
    }

    /* =========================
       RECYCLE BIN (TRASH & RECOVERY)
    ========================== */
    match /recycle_bin/{binId} {
      allow read, write: if isAdminOrStaff();
    }

    /* =========================
       APP POLICIES & LEGAL HUB (GOOGLE PLAY / APP STORE)
    ========================== */
    match /app_policies/{policyId} {
      // Public & Google Play reviewers must be able to view policies without authentication
      allow read: if true;
      allow create, update, delete: if isAdminOrStaff();
    }

    /* =========================
       APP USER DATA DELETION REQUESTS
    ========================== */
    match /app_data_deletion_requests/{requestId} {
      // Any app user can publicly submit an account/data deletion request
      allow create: if true;
      allow read, update, delete: if isAdminOrStaff();
    }

    /* =========================
       APP SETTINGS (PDF Branding & System Config)
    ========================== */
    match /app_settings/{settingId} {
      // Public can read branding settings (needed for dynamic PDF invoices & agreements)
      allow read: if true;
      // Only admin can write settings
      allow write: if isAdmin();
    }

    /* =========================
       CONTRACTS & AGREEMENTS MANAGEMENT
    ========================== */
    match /agreements/{agreementId} {
      // Administrators have full control
      allow read, write: if isAdmin();
      // Counterparty/Contributor can read their own agreement if authenticated
      allow read: if isSignedIn() && (
        resource.data.developer.email == request.auth.token.email ||
        resource.data.developer.developerId == request.auth.uid
      );
    }

    match /agreement_addenda/{addendumId} {
      // Administrators have full control over addenda
      allow read, write: if isAdmin();
      // Counterparty can read associated addenda
      allow read: if isSignedIn();
    }

    match /agreement_templates/{templateId} {
      allow read: if isAdminOrStaff();
      allow write: if isAdmin();
    }

    match /agreement_audit_logs/{logId} {
      // Audit logs are append-only by admins; never editable or deletable
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
  }
}

