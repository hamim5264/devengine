rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Public app identity assets, writable only by their active authenticated uploader.
    match /appos-assets/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid &&
        (request.auth.token.email == 'hamim.leon@gmail.com' ||
          (firestore.exists(/databases/(default)/documents/staff_members/$(request.auth.uid)) &&
           firestore.get(/databases/(default)/documents/staff_members/$(request.auth.uid)).data.status == 'active' &&
           firestore.get(/databases/(default)/documents/staff_members/$(request.auth.uid)).data.allowedModules.hasAny(['appos', 'all']))) &&
        request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }
    // Universal rules for DevEngine workspace & eco-system
    match /{allPaths=**} {
      // 1. Public read so images, PDFs, deliverables, and attachments render everywhere
      allow read: if true;

      // 2. Allow writes with 25 MB size limit (No 30-day expiration, zero blockers)
      // Any authenticated admin/staff, or app client uploads safely under 25 MB
      allow write: if !allPaths.matches('appos-assets/.*') && request.resource.size < 25 * 1024 * 1024;
    }
  }
}
